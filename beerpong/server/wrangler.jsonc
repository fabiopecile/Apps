{
  // Der Server für den Online-Modus. Eine einzige Datei, kostenlos zu
  // betreiben: der Workers-Free-Plan deckt 100.000 Anfragen pro Tag ab, und
  // ein Beerpong-Spiel sind ein paar Dutzend Nachrichten.
  //
  // Veröffentlichen:  npx wrangler deploy
  // (Im Repository macht das der Workflow .github/workflows/deploy-server.yml.)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beerpong-rooms",
  "main": "worker.ts",
  "compatibility_date": "2025-04-01",
  "observability": { "enabled": true },
  // Nicht geheim, deshalb hier und nicht im Dashboard: Was hier steht, ersetzt
  // beim Veröffentlichen die Variablen im Cloudflare-Dashboard. Geheimnisse
  // (STRIPE_SECRET_KEY, LICENCE_SECRET) sind davon nicht betroffen — die
  // bleiben stehen und gehören auch nirgendwo anders hin.
  "vars": {
    // Was auf dem Kontoauszug des Käufers nach dem Konto-Namen steht. Wichtig,
    // wenn dasselbe Stripe-Konto noch etwas anderes verkauft: Eine Abbuchung
    // von einem unbekannten Namen wird reklamiert.
    "SHOP_STATEMENT_SUFFIX": "BEERPONG"
    // Preis aus dem Stripe-Katalog statt aus dem Code. Die ID steht im
    // Dashboard beim Produkt („Beerpong PRO") am Preis. Zeile einkommentieren
    // und die eigene ID eintragen:
    // , "STRIPE_PRICE_ID": "price_1ABC..."
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "SAVES", "class_name": "Save" }
    ]
  },
  // SQLite-Backend: das ist die Variante, die im kostenlosen Plan enthalten ist.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Save"] }
  ]
}
